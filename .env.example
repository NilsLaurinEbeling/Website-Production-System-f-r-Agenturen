# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Upstash QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Vercel (for programmatic custom-domain assignment on deploy)
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id
VERCEL_PROJECT_ID=your-vercel-project-id

# App URL (used for QStash to call back into this app)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Extra hostnames that should serve the dashboard/app instead of a customer
# site (comma-separated). The NEXT_PUBLIC_BASE_URL host, localhost, and
# *.vercel.app are always treated as app hosts.
APP_HOSTS=
